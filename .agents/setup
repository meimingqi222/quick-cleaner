#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
SECONDS=0
echo '[orb setup] Checking Debian tools'
packages=(ca-certificates curl git python3 shellcheck)
missing=()
for package in "${packages[@]}"; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

# The toolchain version comes from go.mod, so setup and the module never disagree.
go_version="$(awk '$1 == "go" { print $2; exit }' "$repo_root/go.mod")"
go_root="$HOME/.local/go"
echo "[orb setup ${SECONDS}s] Preparing Go ${go_version}"
if [[ ! -x "$go_root/bin/go" ]] || [[ "$("$go_root/bin/go" env GOVERSION)" != "go${go_version}" ]]; then
    rm -rf "$go_root"
    mkdir -p "$go_root"
    curl --proto '=https' --tlsv1.2 -fsSL "https://go.dev/dl/go${go_version}.linux-amd64.tar.gz" | tar -xz -C "$go_root" --strip-components=1
fi
if ! grep -Fqx '# QuickCleaner orb Go toolchain' "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'PROFILE'

# QuickCleaner orb Go toolchain
export PATH="$HOME/.local/go/bin:$HOME/go/bin:$PATH"
PROFILE
fi
export PATH="$go_root/bin:$PATH"

echo "[orb setup ${SECONDS}s] Warming module cache"
(cd "$repo_root" && go mod download)
echo "[orb setup ${SECONDS}s] Ready for gofmt, go vet and Python guards. Native build/test/run requires macOS or Windows."
