# Rust 构建产物
/target
/dist
*.pdb
*.ilk
*.rs.bk

# 测试与覆盖率分析产物
*.profraw
*.profdata
coverage/

# 项目内部临时文档与交接文档
/docs/*
!/docs/PITFALLS.md
!/docs/agent-notes/
!/docs/compose/
/docs/compose/*
!/docs/compose/spec/
/docs/compose/spec/*
!/docs/compose/spec/windows-unregistered-apps.md

# Stitch 设计稿（HTML + 大尺寸 PNG）。状态监控页的模块注释引用了它作为出处，
# 但几百 KB 的位图不该进版本库，需要时从 Stitch 重新导出。
/.stitch/

# 本地临时数据与对比基准（如 WizTree 导出的数百 MB 校验 CSV）
WizTree_*.csv
*.tmp
*.bak
*.log

# 回归证据日志是唯一例外：Proved: 行引用的红跑输出要进版本库，
# 所以 evidence 目录的放行必须排在 *.log 之后。
!/docs/agent-notes-evidence/
!/docs/agent-notes-evidence/*.log

# 操作系统自动生成文件
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
-InstallDir/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 编辑器与 IDE 配置文件
.idea/
.vscode/
.commandcode/
/.zcode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.workbuddy
.apodex
tmp/
__pycache__/
*.pyc

# 本地环境变量与凭据；示例模板允许提交
.env
.env.*
!.env.example
!.env.sample
!.env.template
