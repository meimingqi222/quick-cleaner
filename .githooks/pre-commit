#!/bin/sh
# 提交前检查：暂存的 Go 文件必须已 gofmt；PITFALLS 的 Note 指针必须有效。
# 有问题时阻止提交，修好后重新 stage。

staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if [ -n "$staged_go" ]; then
    unformatted=$(gofmt -l $staged_go)
    if [ -n "$unformatted" ]; then
        echo "以下 Go 文件未 gofmt，请执行 gofmt -w 后重新 stage：" >&2
        echo "$unformatted" >&2
        exit 1
    fi
fi

# Windows 的 WindowsApps 执行别名（含商店版 Python）从 Git Bash 启动会永久挂起，
# 连 kill -9 都停不掉，所以不能靠「试跑 + 超时」探测，只能事先跳过。
# QC_PYTHON 可显式指定解释器。
find_python() {
    if [ -n "$QC_PYTHON" ]; then
        echo "$QC_PYTHON"
        return
    fi
    for name in python3 python; do
        old_ifs=$IFS
        IFS=:
        for dir in $PATH; do
            IFS=$old_ifs
            case "$dir" in
                *[Ww]indows[Aa]pps*) continue ;;
            esac
            for exe in "$dir/$name" "$dir/$name.exe"; do
                if [ -f "$exe" ] && [ -x "$exe" ] && "$exe" -c "" >/dev/null 2>&1; then
                    echo "$exe"
                    return
                fi
            done
        done
        IFS=$old_ifs
    done
    if command -v py >/dev/null 2>&1 && py -3 -c "" >/dev/null 2>&1; then
        echo "py -3"
    fi
}
PY=$(find_python)
run_py() {
    if [ "$PY" = "py -3" ]; then py -3 "$@"; else "$PY" "$@"; fi
}
if [ -z "$PY" ]; then
    echo "pre-commit：找不到可用的 Python，跳过 note 检查" >&2
    exit 0
fi

# 反查提醒（不阻断）：暂存文件若有 note 锁定，打印出来提醒先读。
VN=tools/regression-notes/verify-notes.py
staged=$(git diff --cached --name-only --diff-filter=ACMR | tr '\n' ' ')
if [ -f "$VN" ] && [ -n "$staged" ]; then
    out=$(run_py "$VN" --notes-dir docs/agent-notes --for-path $staged 2>/dev/null)
    case "$out" in
        *"note(s) cite"*) ;;
        *) out="" ;;
    esac
    if [ -n "$out" ] && ! echo "$out" | grep -q "^0 note(s)"; then
        echo "== 以下暂存文件被回归 note 锁定，提交前确认已读 ==" >&2
        echo "$out" | grep -v "note(s) cite" | grep . >&2
    fi
fi
run_py -X utf8 scripts/check-pitfall-notes.py || exit 1
exit 0
