# Rust 构建产物。Rust 源仍是 Go 移植的行为参照，cargo 检查照旧在 CI 跑，不能因为发布改走 Go 就删掉。
/target
/dist
.amp/portals/
*.pdb
*.ilk
*.rs.bk

# Go 构建产物。`go build ./...` 会把 main 包的可执行文件落在 cwd，打包脚本的输出统一进 /dist。
/quick-cleaner
/quick-cleaner.exe
/ui-gallery
/ui-gallery.exe
*.test
coverage.out
*.coverprofile

# cmd/quick-cleaner/rsrc_windows_*.syso 由 tools/winres 生成，但图标、版本信息和清单只靠它，
# `tools/winres --check` 校验的也是入库的那份，所以它必须可提交，不要并进上面的构建产物规则。
!cmd/quick-cleaner/rsrc_windows_*.syso

# 测试与覆盖率分析产物
*.profraw
*.profdata
coverage/

# 项目内部临时文档与交接文档。临时调查、审查、spike 结论放 docs/temp/，只留在本地；
# 跨批次维护、描述现有代码的文档才逐个放行。
/docs/*
/docs/temp/
!/docs/PITFALLS.md
!/docs/UI_MIGRATION.md
!/docs/UI_POPOVER.md
!/docs/UI_COMPONENTS.md
!/docs/ui-baselines/
!/docs/agent-notes/
!/docs/compose/
/docs/compose/*
!/docs/compose/spec/
/docs/compose/spec/*
!/docs/compose/spec/windows-unregistered-apps.md

# Stitch 设计稿（HTML + 大尺寸 PNG）。状态监控页的模块注释引用了它作为出处，
# 但几百 KB 的位图不该进版本库，需要时从 Stitch 重新导出。
/.stitch/

# 本地临时数据与对比基准（如 WizTree 导出的数百 MB 校验 CSV）
WizTree_*.csv
*.tmp
*.bak
*.log

# 回归证据日志是唯一例外：Proved: 行引用的红跑输出要进版本库，
# 所以 evidence 目录的放行必须排在 *.log 之后。
!/docs/agent-notes-evidence/
!/docs/agent-notes-evidence/*.log

# 操作系统自动生成文件
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
-InstallDir/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# 编辑器与 IDE 配置文件
.idea/
.vscode/
.commandcode/
/.zcode/
.claude/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.workbuddy
.apodex
tmp/
__pycache__/
*.pyc

# 本地环境变量与凭据；示例模板允许提交
.env
.env.*
!.env.example
!.env.sample
!.env.template
